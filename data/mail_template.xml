<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_scrap_validation_required" model="mail.template">
        <field name="name">AR Scrap - Validation requise</field>
        <field name="model_id" ref="model_ar_scrap_order"/>
        <field name="subject">Validation requise - Déclaration SCRAP {{ object.name }}</field>
        <field name="email_from">{{ object.env.company.partner_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to"/>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;font-family:Arial,sans-serif;color:#263143;">
                <div style="max-width:680px;margin:0 auto;border:1px solid #e0e5ec;border-radius:14px;overflow:hidden;background:#ffffff;">
                    <div style="padding:24px 28px;color:#ffffff;background-color:#714b67;">
                        <div style="font-size:11px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:#b9f3ef;">AR Scrap</div>
                        <h2 style="margin:7px 0 0;font-size:23px;color:#ffffff;">Validation requise</h2>
                    </div>
                    <div style="padding:26px 28px;">
                        <p style="margin:0 0 16px;">Bonjour,</p>
                        <p style="margin:0 0 20px;line-height:1.6;">
                            La déclaration SCRAP <strong><t t-out="object.name"/></strong> nécessite votre validation.
                        </p>

                        <table style="width:100%;border-collapse:collapse;margin-bottom:22px;background:#f7f9fb;border-radius:10px;">
                            <tbody>
                                <tr>
                                    <td style="padding:10px 14px;color:#6b7586;width:42%;">Déclaré par</td>
                                    <td style="padding:10px 14px;font-weight:bold;"><t t-out="object.user_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 14px;color:#6b7586;">Date et heure</td>
                                    <td style="padding:10px 14px;font-weight:bold;"><t t-out="object.get_scrap_datetime_display()"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 14px;color:#6b7586;">Shift</td>
                                    <td style="padding:10px 14px;font-weight:bold;"><t t-out="object.get_shift_label()"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 14px;color:#6b7586;">OF</td>
                                    <td style="padding:10px 14px;font-weight:bold;"><t t-out="object.production_order_number or ''"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 14px;color:#6b7586;">Quantité OF</td>
                                    <td style="padding:10px 14px;font-weight:bold;"><t t-out="object.production_order_quantity"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 14px;color:#6b7586;">Quantité totale</td>
                                    <td style="padding:10px 14px;font-weight:bold;"><t t-out="object.total_quantity"/></td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 14px;color:#6b7586;">Montant total</td>
                                    <td style="padding:10px 14px;font-weight:bold;color:#087f67;"><t t-out="object.get_total_amount_display()"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="object.notes">
                            <div style="margin-bottom:22px;padding:13px 15px;border-left:4px solid #714b67;background:#f7f4f7;border-radius:7px;">
                                <div style="margin-bottom:5px;font-size:11px;font-weight:bold;text-transform:uppercase;color:#714b67;">Commentaire général</div>
                                <div style="white-space:pre-wrap;line-height:1.5;"><t t-out="object.notes"/></div>
                            </div>
                        </t>

                        <div style="margin-bottom:22px;">
                            <div style="margin-bottom:9px;font-weight:bold;">Références scrapées</div>
                            <table style="width:100%;border-collapse:collapse;border:1px solid #e2e7ed;">
                                <thead>
                                    <tr style="background:#f0f3f7;">
                                        <th style="padding:9px 11px;text-align:left;border-bottom:1px solid #e2e7ed;">Référence</th>
                                        <th style="padding:9px 11px;text-align:right;border-bottom:1px solid #e2e7ed;">Quantité</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="object.line_ids" t-as="line">
                                        <td style="padding:9px 11px;border-bottom:1px solid #edf0f3;"><t t-out="line.product_name"/></td>
                                        <td style="padding:9px 11px;text-align:right;border-bottom:1px solid #edf0f3;"><t t-out="line.quantity"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <t t-set="base_url" t-value="object.get_base_url()"/>
                        <div style="margin:25px 0;text-align:center;">
                            <a t-attf-href="{{ base_url }}/web#id={{ object.id }}&amp;model=ar.scrap.order&amp;view_type=form"
                               style="display:inline-block;padding:11px 20px;border-radius:8px;background-color:#16834f;color:#ffffff;text-decoration:none;font-weight:bold;">
                                Consulter et valider la déclaration
                            </a>
                        </div>

                        <p style="margin:20px 0 0;color:#6b7586;">Cordialement,<br/>AR Scrap</p>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
