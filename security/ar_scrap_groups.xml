<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ar_scrap" model="ir.module.category">
        <field name="name">AR Scrap</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_ar_scrap_production_order" model="res.groups.privilege">
        <field name="name">Intégration OF</field>
        <field name="category_id" ref="module_category_ar_scrap"/>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_ar_scrap_settings" model="res.groups.privilege">
        <field name="name">Paramétrage</field>
        <field name="category_id" ref="module_category_ar_scrap"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_ar_scrap_production_order" model="res.groups">
        <field name="name">Accès Intégration OF</field>
        <field name="comment">Permet de voir et de gérer le menu Intégration OF.</field>
        <field name="privilege_id" ref="privilege_ar_scrap_production_order"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_ar_scrap_settings" model="res.groups">
        <field name="name">Accès Paramétrage</field>
        <field name="comment">Permet de voir et de gérer le menu Paramétrage AR Scrap.</field>
        <field name="privilege_id" ref="privilege_ar_scrap_settings"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
</odoo>
