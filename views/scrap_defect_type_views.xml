<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ar_scrap_defect_type_list" model="ir.ui.view">
        <field name="name">ar.scrap.defect.type.list</field>
        <field name="model">ar.scrap.defect.type</field>
        <field name="arch" type="xml">
            <list string="Types de défaut" default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" options="{'size': [48, 48]}"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ar_scrap_defect_type_form" model="ir.ui.view">
        <field name="name">ar.scrap.defect.type.form</field>
        <field name="model">ar.scrap.defect.type</field>
        <field name="arch" type="xml">
            <form string="Type de défaut">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du type de défaut..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Description du type de défaut..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ar_scrap_defect_type" model="ir.actions.act_window">
        <field name="name">Types de défaut</field>
        <field name="group_ids" eval="[Command.link(ref('ar_scrap.group_ar_scrap_settings'))]"/>
        <field name="res_model">ar.scrap.defect.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
