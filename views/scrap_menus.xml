<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ar_scrap_cart" model="ir.actions.client">
        <field name="name">Déclaration SCRAP</field>
        <field name="tag">ar_scrap.cart</field>
    </record>

    <menuitem id="menu_ar_scrap_root" name="AR Scrap" sequence="20" groups="base.group_user"/>
    <menuitem id="menu_ar_scrap_cart" name="Déclaration SCRAP" parent="menu_ar_scrap_root" action="action_ar_scrap_cart" sequence="10" groups="base.group_user"/>
    <menuitem id="menu_ar_scrap_production_order" name="Intégration OF" parent="menu_ar_scrap_root" action="action_ar_scrap_production_order" sequence="12" groups="group_ar_scrap_production_order"/>
    <menuitem id="menu_ar_scrap_validations" name="Validations" parent="menu_ar_scrap_root" action="action_ar_scrap_order_validation" sequence="15" groups="base.group_user"/>
    <menuitem id="menu_ar_scrap_archive" name="Archive" parent="menu_ar_scrap_root" sequence="20" groups="base.group_user"/>
    <record id="menu_ar_scrap_archive" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>
    <menuitem id="menu_ar_scrap_archive_validated" name="Validées" parent="menu_ar_scrap_archive" action="action_ar_scrap_order_archive" sequence="10" groups="base.group_user"/>
    <menuitem id="menu_ar_scrap_archive_refused" name="Refusées" parent="menu_ar_scrap_archive" action="action_ar_scrap_order_refused" sequence="20" groups="base.group_user"/>
    <menuitem id="menu_ar_scrap_documentation" name="Documentation" parent="menu_ar_scrap_root" action="action_ar_scrap_documentation" sequence="30" groups="base.group_user"/>
    <menuitem id="menu_ar_scrap_settings" name="Paramétrage" parent="menu_ar_scrap_root" sequence="40" groups="group_ar_scrap_settings"/>
    <record id="menu_ar_scrap_settings" model="ir.ui.menu">
        <field name="action" eval="False"/>
        <field name="group_ids" eval="[Command.set([ref('ar_scrap.group_ar_scrap_settings')])]"/>
    </record>
    <menuitem id="menu_ar_scrap_product" name="Références" parent="menu_ar_scrap_settings" action="action_ar_scrap_product" sequence="10" groups="group_ar_scrap_settings"/>
    <menuitem id="menu_ar_scrap_zone" name="Zones de scrap" parent="menu_ar_scrap_settings" action="action_ar_scrap_zone" sequence="20" groups="group_ar_scrap_settings"/>
    <menuitem id="menu_ar_scrap_defect_type" name="Type de défaut" parent="menu_ar_scrap_settings" action="action_ar_scrap_defect_type" sequence="25" groups="group_ar_scrap_settings"/>
    <menuitem id="menu_ar_scrap_validation_rule" name="Règles de validation" parent="menu_ar_scrap_settings" action="action_ar_scrap_validation_rule" sequence="30" groups="group_ar_scrap_settings"/>

    <!-- Command.set remplace les anciens groupes conservés lors des mises à jour du module. -->
    <record id="menu_ar_scrap_production_order" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('ar_scrap.group_ar_scrap_production_order')])]"/>
    </record>
    <record id="menu_ar_scrap_product" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('ar_scrap.group_ar_scrap_settings')])]"/>
    </record>
    <record id="menu_ar_scrap_zone" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('ar_scrap.group_ar_scrap_settings')])]"/>
    </record>
    <record id="menu_ar_scrap_defect_type" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('ar_scrap.group_ar_scrap_settings')])]"/>
    </record>
    <record id="menu_ar_scrap_validation_rule" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('ar_scrap.group_ar_scrap_settings')])]"/>
    </record>
</odoo>
