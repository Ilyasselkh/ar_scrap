<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ar_scrap_validation_rule_list" model="ir.ui.view">
        <field name="name">ar.scrap.validation.rule.list</field>
        <field name="model">ar.scrap.validation.rule</field>
        <field name="arch" type="xml">
            <list string="Règles de validation" default_order="quantity_from,quantity_to">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="quantity_from" widget="monetary"/>
                <field name="quantity_to" widget="monetary"/>
                <field name="supervisor_ids" widget="many2many_tags" optional="show"/>
                <field name="manager_ids" widget="many2many_tags" optional="show"/>
                <field name="md_ids" widget="many2many_tags" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ar_scrap_validation_rule_form" model="ir.ui.view">
        <field name="name">ar.scrap.validation.rule.form</field>
        <field name="model">ar.scrap.validation.rule</field>
        <field name="arch" type="xml">
            <form string="Règle de validation">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="True"/></h1>
                    </div>
                    <group>
                        <group string="Intervalle de valeur">
                            <field name="currency_id" invisible="True"/>
                            <field name="quantity_from" widget="monetary"/>
                            <field name="quantity_to" widget="monetary"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Circuit de validation">
                            <field name="supervisor_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="manager_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="md_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Les niveaux renseignés sont traités dans l'ordre : Superviseur, Manager, puis MD.
                        Les limites de valeur sont incluses, dans la devise de la société, et deux règles actives ne peuvent pas se chevaucher.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ar_scrap_validation_rule" model="ir.actions.act_window">
        <field name="name">Règles de validation</field>
        <field name="group_ids" eval="[Command.link(ref('ar_scrap.group_ar_scrap_settings'))]"/>
        <field name="res_model">ar.scrap.validation.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
