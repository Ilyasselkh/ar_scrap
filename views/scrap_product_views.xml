<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ar_scrap_product_list" model="ir.ui.view">
        <field name="name">ar.scrap.product.list</field>
        <field name="model">ar.scrap.product</field>
        <field name="arch" type="xml">
            <list string="Références scrap" default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" options="{'size': [48, 48]}"/>
                <field name="name"/>
                <field name="length"/>
                <field name="unit_price" widget="monetary"/>
                <field name="currency_id" optional="show"/>
                <field name="zone_id"/>
                <field name="exists_in_sap" widget="boolean_toggle"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ar_scrap_product_kanban" model="ir.ui.view">
        <field name="name">ar.scrap.product.kanban</field>
        <field name="model">ar.scrap.product</field>
        <field name="arch" type="xml">
            <kanban class="ar_scrap_product_kanban" quick_create="false">
                <field name="name"/>
                <field name="image_128"/>
                <field name="length"/>
                <field name="unit_price"/>
                <field name="currency_id"/>
                <field name="description"/>
                <field name="zone_id"/>
                <field name="exists_in_sap"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <field name="image_128" widget="image" class="mb-2"/>
                            <strong><field name="name"/></strong>
                            <div t-if="record.zone_id.raw_value" class="text-primary"><i class="fa fa-map-marker"/> <field name="zone_id"/></div>
                            <div class="text-muted"><field name="length"/> mm de longueur</div>
                            <div class="text-success"><field name="unit_price" widget="monetary"/></div>
                            <small><field name="description"/></small>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ar_scrap_product_form" model="ir.ui.view">
        <field name="name">ar.scrap.product.form</field>
        <field name="model">ar.scrap.product</field>
        <field name="arch" type="xml">
            <form string="Référence scrap">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom de la référence..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="length"/>
                            <field name="unit_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="zone_id" options="{'no_create_edit': False}"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="exists_in_sap" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Description affichée dans le panier..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ar_scrap_product" model="ir.actions.act_window">
        <field name="name">Paramétrage</field>
        <field name="res_model">ar.scrap.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
