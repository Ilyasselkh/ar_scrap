<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ar_scrap_production_order_list" model="ir.ui.view">
        <field name="name">ar.scrap.production.order.list</field>
        <field name="model">ar.scrap.production.order</field>
        <field name="arch" type="xml">
            <list string="Intégration OF" default_order="valid_from desc,name">
                <field name="name"/>
                <field name="quantity"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ar_scrap_production_order_form" model="ir.ui.view">
        <field name="name">ar.scrap.production.order.form</field>
        <field name="model">ar.scrap.production.order</field>
        <field name="arch" type="xml">
            <form string="Intégration OF">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Numéro OF..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="quantity"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Période de validité">
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        L'OF sera proposé dans la Déclaration SCRAP uniquement lorsque la date sélectionnée se trouve dans cette période et que l'OF est actif.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ar_scrap_production_order_search" model="ir.ui.view">
        <field name="name">ar.scrap.production.order.search</field>
        <field name="model">ar.scrap.production.order</field>
        <field name="arch" type="xml">
            <search string="Rechercher un OF">
                <field name="name"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <filter name="active_orders" string="Actifs" domain="[('active', '=', True)]"/>
                <filter name="archived_orders" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ar_scrap_production_order" model="ir.actions.act_window">
        <field name="name">Intégration OF</field>
        <field name="group_ids" eval="[Command.link(ref('ar_scrap.group_ar_scrap_production_order'))]"/>
        <field name="res_model">ar.scrap.production.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ar_scrap_production_order_search"/>
        <field name="context">{'active_test': False, 'search_default_active_orders': 1}</field>
    </record>
</odoo>
